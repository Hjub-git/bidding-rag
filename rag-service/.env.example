DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 内部服务令牌（T05-A）：Java 用 X-Internal-Token 头调本服务，除 GET /api/health
# 外所有接口都校验它。
# 安全（2026-11-06）：**不再有默认值**。缺失或过短时本服务启动即失败（fail-fast）。
# 由 start-all.ps1 生成 32 字节随机值 → _run/rag-token.txt，并注入两侧环境变量；
# 手工起服务时请显式 export RAG_INTERNAL_TOKEN（与 Java 侧同值）。
RAG_INTERNAL_TOKEN=
