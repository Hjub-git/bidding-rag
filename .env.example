# ─────────────────────────────────────────────────────────────
#  Bidding RAG · 环境变量模板（只放占位，绝不放真值）
#
#  复制到 rag-service/.env 再填值（Python 侧 load_dotenv() 在 rag-service/ 下读它）：
#      copy .env.example rag-service\.env
#
#  .env 已在 .gitignore 里；提交前自查：
#      git status --short | findstr ".env"
# ─────────────────────────────────────────────────────────────

# 大模型（必填）：DeepSeek 的 OpenAI 兼容 API Key
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 内部服务令牌（可选）：Java → Python 的唯一凭证，两侧必须逐字符一致。
# 不填则由 scripts/start-all.ps1 自动生成 32 字节随机值并写入 _run/rag-token.txt，
# 同时注入两侧环境变量。**不要**手写弱口令——历史默认串是公开的，等于没有鉴权。
RAG_INTERNAL_TOKEN=

# JWT 签名密钥（可选）：HS256 要求 >= 32 字节。
# 不填则由 scripts/start-all.ps1 自动生成 48 字节随机值写入 _run/jwt-secret.txt。
JWT_SECRET=

# ── 以下均为可选（不填走默认值）───────────────────────────────

# MySQL 账号（默认 root / 见 README「快速开始」）
# DB_USER=root
# DB_PASSWORD=your_mysql_password

# 上传文件落盘根目录：Java 与 Python 必须同值。
# start-all.ps1 会自动注入 <仓库根>/rag-service/data 这个绝对路径，一般不用手填。
# RAG_DATA_ROOT=

# Python 解释器 / JDK17 的路径（start-all.ps1 默认已写死本机常见位置，换机器时再覆盖）
# RAG_PYTHON=C:\Path\To\Python39\python.exe
# JAVA_EXE=C:\Program Files\Java\jdk-17\bin\java.exe

# 评测用向量库（默认 eval/vector_base；不入库，首次用 --reingest 生成）
# VECTOR_DB_PATH=.\rag-service\vector_data
