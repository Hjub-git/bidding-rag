# 默认：文本文件入库用 LF，检出时按平台自动转换
* text=auto eol=lf

# Windows 脚本必须保持 CRLF（PowerShell / cmd 对行尾敏感）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码与文档统一 LF
*.java text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.vue  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.txt  text eol=lf

# 二进制，不参与换行转换
*.pdf  binary
*.docx binary
*.xlsx binary
*.jar  binary
*.png  binary
*.jpg  binary
